{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Egress Audit",
      "url": "/d/iron-proxy-audit",
      "type": "link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "Response Codes",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["sum"] }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum by (status_code) (count_over_time({service_name=\"iron-proxy\"} | label_format host=`{{ regexReplaceAll \":[0-9]+$\" .host \"\" }}` | host != \"\" | host =~ \"$host\" | method =~ \"$method\" [$__range]))",
          "legendFormat": "{{status_code}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Status Code Distribution",
      "type": "piechart"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": { "group": "A", "mode": "normal" }
          }
        }
      },
      "gridPos": { "h": 10, "w": 16, "x": 8, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum by (status_code) (rate({service_name=\"iron-proxy\"} | label_format host=`{{ regexReplaceAll \":[0-9]+$\" .host \"\" }}` | host != \"\" | host =~ \"$host\" | method =~ \"$method\" [$__interval]))",
          "legendFormat": "{{status_code}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Status Codes over Time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 11 },
      "id": 3,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["sum"] },
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "topk(10, sum by (host, status_code) (count_over_time({service_name=\"iron-proxy\"} | label_format host=`{{ regexReplaceAll \":[0-9]+$\" .host \"\" }}` | host != \"\" | host =~ \"$host\" | method =~ \"$method\" [$__range])))",
          "legendFormat": "{{host}} / {{status_code}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Top Domains by Status Code",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 11,
      "title": "Latency (APM)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [
              {
                "id": "color",
                "value": { "fixedColor": "orange", "mode": "fixed" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [
              {
                "id": "color",
                "value": { "fixedColor": "red", "mode": "fixed" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [
              {
                "id": "color",
                "value": { "fixedColor": "green", "mode": "fixed" }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 21 },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max", "lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "quantile_over_time(0.50, {service_name=\"iron-proxy\"} | label_format host=`{{ regexReplaceAll \":[0-9]+$\" .host \"\" }}` | host != \"\" | host =~ \"$host\" | method =~ \"$method\" | unwrap duration_ms [$__interval])",
          "legendFormat": "p50",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=\"iron-proxy\"} | label_format host=`{{ regexReplaceAll \":[0-9]+$\" .host \"\" }}` | host != \"\" | host =~ \"$host\" | method =~ \"$method\" | unwrap duration_ms [$__interval])",
          "legendFormat": "p95",
          "queryType": "range",
          "refId": "B"
        },
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "quantile_over_time(0.99, {service_name=\"iron-proxy\"} | label_format host=`{{ regexReplaceAll \":[0-9]+$\" .host \"\" }}` | host != \"\" | host =~ \"$host\" | method =~ \"$method\" | unwrap duration_ms [$__interval])",
          "legendFormat": "p99",
          "queryType": "range",
          "refId": "C"
        }
      ],
      "title": "Latency Percentiles — P50 / P95 / P99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        }
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 31 },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "topk(10, quantile_over_time(0.95, {service_name=\"iron-proxy\"} | label_format host=`{{ regexReplaceAll \":[0-9]+$\" .host \"\" }}` | host != \"\" | host =~ \"$host\" | method =~ \"$method\" | unwrap duration_ms [$__interval]) by (host))",
          "legendFormat": "{{host}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "P95 Latency by Domain (top 10)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": ["iron-proxy", "apm", "devcontainer"],
